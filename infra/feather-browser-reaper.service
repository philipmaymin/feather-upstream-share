[Unit]
Description=Reap stale Feather-managed browser process trees
After=network.target

[Service]
Type=simple
User=user
Group=user
Environment=HOME=/home/user
Environment=FEATHER_BROWSER_REAPER_MIN_AGE_SECONDS=86400
Environment=FEATHER_BROWSER_REAPER_IDLE_SECONDS=3600
Environment=FEATHER_BROWSER_REAPER_INTERVAL_SECONDS=900
ExecStart=/home/user/.local/share/feather/current/bin/feather-browser-reaper --loop
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
